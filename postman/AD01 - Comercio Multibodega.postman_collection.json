    {
      "name": "Flujo E2E",
      "item": [
        {
          "name": "Crear cliente + pedido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"IdCliente\": 1,\n  \"Detalles\": [\n    {\n      \"IdProducto\": 2,\n      \"IdBodega\": 1,\n      \"Cantidad\": 1\n    },\n    {\n      \"IdProducto\": 3,\n      \"IdBodega\": 2,\n      \"Cantidad\": 2\n    }\n  ]\n}"
            },
            "url": { "raw": "{{pedidosUrl}}/api/pedidos", "host": ["{{pedidosUrl}}"], "path": ["api", "pedidos"] }
