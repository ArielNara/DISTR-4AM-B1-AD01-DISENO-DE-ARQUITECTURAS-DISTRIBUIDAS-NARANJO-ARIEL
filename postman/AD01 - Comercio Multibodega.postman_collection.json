{
  "info": {
    "name": "AD01 - Comercio Multibodega",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de pruebas para Catalogo, Inventario y Pedidos"
  },
  "item": [
    {
      "name": "Catalogo.Api",
      "item": [
        {
          "name": "GET /api/categorias",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{catalogoUrl}}/api/categorias", "host": ["{{catalogoUrl}}"], "path": ["api", "categorias"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/categorias",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Nombre\": \"Accesorios\",\n  \"Descripcion\": \"Categoría de prueba\"\n}"
            },
            "url": { "raw": "{{catalogoUrl}}/api/categorias", "host": ["{{catalogoUrl}}"], "path": ["api", "categorias"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201 o 409\", function () { pm.expect([201, 409]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
