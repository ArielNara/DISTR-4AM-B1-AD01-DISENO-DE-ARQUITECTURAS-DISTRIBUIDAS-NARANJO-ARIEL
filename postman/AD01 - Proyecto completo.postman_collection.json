        },
        {
          "name": "GET - Obtener reserva por ID",
          "request": { "method": "GET", "header": [], "url": "{{inventarioUrl}}/api/reservas/{{reservaId}}" }
        },
        {
          "name": "POST - Crear reserva",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idProducto\": {{productoId}},\n  \"idBodega\": {{bodegaId}},\n  \"cantidad\": 1,\n  \"referenciaExterna\": \"POSTMAN-{{$timestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{inventarioUrl}}/api/reservas"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 201) { pm.collectionVariables.set('reservaId', String(pm.response.json().idReserva)); }",
                "pm.test('Reserva creada', function () { pm.response.to.have.status(201); });"
              ]
            }
          }]
        },
        {
          "name": "PUT - Confirmar reserva",
          "request": { "method": "PUT", "header": [], "url": "{{inventarioUrl}}/api/reservas/{{reservaId}}/confirmar" },
          "description": "Ejecuta después de POST - Crear reserva. Confirma la reserva y descuenta stock. No ejecutes también Cancelar sobre la misma reserva."
        },
        {
          "name": "PUT - Cancelar reserva",
          "request": { "method": "PUT", "header": [], "url": "{{inventarioUrl}}/api/reservas/{{reservaId}}/cancelar" },
          "description": "Ejecuta después de POST - Crear reserva. Cancela la reserva activa. No ejecutes también Confirmar sobre la misma reserva."
        }
      ]
    },
    {
      "name": "08 - Pedidos.Api - Clientes",
      "item": [
        {
          "name": "GET - Listar clientes",
