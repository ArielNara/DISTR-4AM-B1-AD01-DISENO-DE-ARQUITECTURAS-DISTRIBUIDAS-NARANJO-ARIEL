    {
      "name": "05 - Inventario.Api - Existencias",
      "item": [
        {
          "name": "GET - Listar existencias",
          "request": { "method": "GET", "header": [], "url": "{{inventarioUrl}}/api/existencias?idProducto={{productoId}}&idBodega={{bodegaId}}" }
        },
        {
          "name": "GET - Resumen de existencias por producto",
          "request": { "method": "GET", "header": [], "url": "{{inventarioUrl}}/api/existencias/producto/{{productoId}}" },
          "description": "Valida el producto mediante Catalogo.Api."
        },
        {
          "name": "PUT - Ajustar stock",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idProducto\": {{productoId}},\n  \"idBodega\": {{bodegaId}},\n  \"nuevoStock\": 20,\n  \"motivo\": \"Ajuste de existencias desde Postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{inventarioUrl}}/api/existencias/ajuste"
          },
          "description": "Cambia el stock físico al valor indicado. Para probar sin tocar un producto semilla, primero crea un producto y configura productoId con su ID."
        }
      ]
    },
    {
      "name": "06 - Inventario.Api - Movimientos",
