{
  "info": {
    "name": "AD01 - Proyecto completo",
    "description": "Colección Postman v2.1 para todos los endpoints de Catalogo.Api, Inventario.Api y Pedidos.Api, con ejemplos CRUD y flujo E2E de Manzana Cordillera. Los servicios deben estar levantados localmente en los puertos 5001, 5002 y 5003.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "catalogoUrl", "value": "http://localhost:5001", "type": "string" },
    { "key": "inventarioUrl", "value": "http://localhost:5002", "type": "string" },
    { "key": "pedidosUrl", "value": "http://localhost:5003", "type": "string" },
    { "key": "categoriaCrudId", "value": "0", "type": "string" },
    { "key": "marcaCrudId", "value": "0", "type": "string" },
    { "key": "productoCrudId", "value": "0", "type": "string" },
    { "key": "productoCrudSku", "value": "", "type": "string" },
    { "key": "bodegaCrudId", "value": "0", "type": "string" },
    { "key": "clienteCrudId", "value": "0", "type": "string" },
    { "key": "productoId", "value": "1", "type": "string" },
    { "key": "bodegaId", "value": "1", "type": "string" },
    { "key": "clienteId", "value": "1", "type": "string" },
    { "key": "pedidoId", "value": "0", "type": "string" },
    { "key": "reservaId", "value": "0", "type": "string" },
    { "key": "e2eCategoriaId", "value": "0", "type": "string" },
    { "key": "e2eMarcaId", "value": "0", "type": "string" },
    { "key": "e2eProductoId", "value": "0", "type": "string" },
    { "key": "e2eSku", "value": "", "type": "string" },
    { "key": "e2ePedidoId", "value": "0", "type": "string" }
  ],
  "item": [
    {
      "name": "01 - Catalogo.Api - Categorias",
      "item": [
        {
          "name": "GET - Listar categorías",
          "request": { "method": "GET", "header": [], "url": "{{catalogoUrl}}/api/categorias" }
        },
        {
          "name": "GET - Obtener categoría por ID",
          "request": { "method": "GET", "header": [], "url": "{{catalogoUrl}}/api/categorias/{{categoriaCrudId}}" },
          "description": "Usa el ID guardado al ejecutar POST - Crear categoría."
        },
        {
          "name": "POST - Crear categoría",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Categoría Postman {{$timestamp}}\",\n  \"descripcion\": \"Categoría de pruebas\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{catalogoUrl}}/api/categorias"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 201) { pm.collectionVariables.set('categoriaCrudId', String(pm.response.json().idCategoria)); }",
                "pm.test('Categoría creada o duplicada al repetir la solicitud', function () { pm.expect([201, 409]).to.include(pm.response.code); });"
              ]
            }
          }]
        },
        {
          "name": "PUT - Actualizar categoría",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Categoría Postman actualizada\",\n  \"descripcion\": \"Categoría actualizada desde Postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{catalogoUrl}}/api/categorias/{{categoriaCrudId}}"
          }
        },
        {
          "name": "DELETE - Eliminar categoría de prueba",
          "request": { "method": "DELETE", "header": [], "url": "{{catalogoUrl}}/api/categorias/{{categoriaCrudId}}" },
          "description": "Solo elimina si no tiene productos asociados. Ejecuta primero POST - Crear categoría."
        }
      ]
    },
