              "mode": "raw",
              "raw": "{\n  \"idCliente\": {{clienteId}},\n  \"detalles\": [\n    {\n      \"idProducto\": {{productoId}},\n      \"idBodega\": {{bodegaId}},\n      \"cantidad\": 1\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{pedidosUrl}}/api/pedidos"
          },
          "event": [{
            "listen": "test",
