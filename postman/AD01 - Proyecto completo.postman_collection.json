    {
      "name": "09 - Pedidos.Api - Pedidos",
      "item": [
        {
          "name": "GET - Listar pedidos",
          "request": { "method": "GET", "header": [], "url": "{{pedidosUrl}}/api/pedidos?idCliente={{clienteId}}" }
        },
        {
          "name": "GET - Obtener pedido por ID",
          "request": { "method": "GET", "header": [], "url": "{{pedidosUrl}}/api/pedidos/{{pedidoId}}" },
