          "request": { "method": "DELETE", "header": [], "url": "{{catalogoUrl}}/api/marcas/{{marcaCrudId}}" },
          "description": "Solo elimina si no tiene productos asociados. Ejecuta primero POST - Crear marca."
        }
      ]
    },
    {
      "name": "03 - Catalogo.Api - Productos",
      "item": [
        {
          "name": "GET - Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{catalogoUrl}}/api/productos?pagina=1&tamanoPagina=10&estado=ACTIVO"
          }
        },
        {
          "name": "GET - Obtener producto por ID",
          "request": { "method": "GET", "header": [], "url": "{{catalogoUrl}}/api/productos/{{productoCrudId}}" },
          "description": "Usa el ID guardado al ejecutar POST - Crear producto."
        },
        {
          "name": "GET - Buscar producto por SKU",
          "request": { "method": "GET", "header": [], "url": "{{catalogoUrl}}/api/productos/sku/{{productoCrudSku}}" },
          "description": "Usa el SKU guardado al ejecutar POST - Crear producto."
        },
        {
          "name": "POST - Crear producto de prueba",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCategoria\": 1,\n  \"idMarca\": 1,\n  \"nombre\": \"Producto Postman {{$timestamp}}\",\n  \"sku\": \"POSTMAN-{{$timestamp}}\",\n  \"precio\": 10.50,\n  \"estado\": \"ACTIVO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{catalogoUrl}}/api/productos"
          },
          "description": "La categoría 1 y marca 1 son datos semilla del proyecto. El SKU usa timestamp para evitar duplicados.",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 201) { var p = pm.response.json(); pm.collectionVariables.set('productoCrudId', String(p.idProducto)); pm.collectionVariables.set('productoCrudSku', p.sku); }",
                "pm.test('Producto creado', function () { pm.response.to.have.status(201); });"
              ]
            }
          }]
        },
        {
          "name": "PUT - Actualizar producto de prueba",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCategoria\": 1,\n  \"idMarca\": 1,\n  \"nombre\": \"Producto Postman actualizado\",\n  \"sku\": \"{{productoCrudSku}}\",\n  \"precio\": 12.75,\n  \"estado\": \"ACTIVO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{catalogoUrl}}/api/productos/{{productoCrudId}}"
          },
          "description": "Ejecuta POST - Crear producto primero."
        },
        {
          "name": "DELETE - Dar de baja producto de prueba",
          "request": { "method": "DELETE", "header": [], "url": "{{catalogoUrl}}/api/productos/{{productoCrudId}}" },
          "description": "Este endpoint realiza baja lógica y cambia el estado a INACTIVO; no borra físicamente. Ejecuta al final."
        }
      ]
    },
    {
