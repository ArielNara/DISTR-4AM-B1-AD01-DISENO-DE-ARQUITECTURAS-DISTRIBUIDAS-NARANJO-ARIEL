    {
      "name": "10 - Flujo E2E - Manzana Cordillera",
      "description": "Ejecuta en orden: crear categoría, crear marca, crear producto, registrar stock y crear pedido. Cada POST guarda automáticamente el ID en variables de la colección.",
      "item": [
        {
          "name": "1 - Crear categoría Frutas",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Frutas Postman {{$timestamp}}\",\n  \"descripcion\": \"Frutas frescas\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{catalogoUrl}}/api/categorias"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 201) { pm.collectionVariables.set('e2eCategoriaId', String(pm.response.json().idCategoria)); }",
                "pm.test('Categoría E2E creada', function () { pm.response.to.have.status(201); });"
              ]
            }
          }]
        },
        {
          "name": "2 - Crear marca Cordillera",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cordillera {{$timestamp}}\",\n  \"paisOrigen\": \"Ecuador\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{catalogoUrl}}/api/marcas"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 201) { pm.collectionVariables.set('e2eMarcaId', String(pm.response.json().idMarca)); }",
                "pm.test('Marca E2E creada', function () { pm.response.to.have.status(201); });"
              ]
            }
          }]
        },
        {
          "name": "3 - Crear producto Manzana Cordillera",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCategoria\": {{e2eCategoriaId}},\n  \"idMarca\": {{e2eMarcaId}},\n  \"nombre\": \"Manzana Cordillera\",\n  \"sku\": \"MANZANA-CORDILLERA-{{$timestamp}}\",\n  \"precio\": 1.25,\n  \"estado\": \"ACTIVO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{catalogoUrl}}/api/productos"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 201) { var p = pm.response.json(); pm.collectionVariables.set('e2eProductoId', String(p.idProducto)); pm.collectionVariables.set('e2eSku', p.sku); }",
                "pm.test('Producto Manzana Cordillera creado', function () { pm.response.to.have.status(201); });"
              ]
            }
          }]
        },
        {
          "name": "4 - Registrar 20 unidades en bodega 1",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idProducto\": {{e2eProductoId}},\n  \"idBodega\": 1,\n  \"nuevoStock\": 20,\n  \"motivo\": \"Stock inicial Manzana Cordillera\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{inventarioUrl}}/api/existencias/ajuste"
          }
        },
        {
          "name": "5 - Crear pedido por 2 manzanas (cliente 1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCliente\": 1,\n  \"detalles\": [\n    {\n      \"idProducto\": {{e2eProductoId}},\n      \"idBodega\": 1,\n      \"cantidad\": 2\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{pedidosUrl}}/api/pedidos"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 201) { pm.collectionVariables.set('e2ePedidoId', String(pm.response.json().idPedido)); }",
                "pm.test('Pedido E2E confirmado por $2.50', function () { pm.response.to.have.status(201); var p = pm.response.json(); pm.expect(p.estado).to.eql('CONFIRMADO'); pm.expect(p.total).to.eql(2.5); });"
              ]
            }
          }]
        },
        {
          "name": "6 - Consultar pedido E2E",
          "request": { "method": "GET", "header": [], "url": "{{pedidosUrl}}/api/pedidos/{{e2ePedidoId}}" }
        },
        {
          "name": "7 - Verificar existencias finales",
          "request": { "method": "GET", "header": [], "url": "{{inventarioUrl}}/api/existencias/producto/{{e2eProductoId}}" },
          "description": "Después del pedido, el stock físico esperado en bodega 1 es 18 unidades."
        }
      ]
    }
  ]
}
